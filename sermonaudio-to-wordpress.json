    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuration').first().json.wordpressBaseUrl }}/wp-json/5mt/v1/sermons",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "password",
              "value": "={{ $('Configuration').first().json.wordpressAppPassword }}"
            },
            {
              "name": "username",
              "value": "={{ $('Configuration').first().json.wordpressUsername }}"
            },
            {
              "name": "title",
              "value": "={{ $('Update Sermon Row').item.json.title }}"
            },
            {
              "name": "date",
              "value": "={{ $('Update Sermon Row').item.json.DateSermon }}"
            },
            {
              "name": "post_status",
              "value": "publish"
            },
            {
              "name": "book",
              "value": "={{ (() => {\n  const raw = $('Update Sermon Row').item.json.books;\n  if (raw === null || raw === undefined || raw === '') return [];\n  const str = Array.isArray(raw) ? raw.join(';') : String(raw);\n\n  const roman = { I: '1', II: '2', III: '3' };\n  const nameMap = {\n    'Psalm': 'Psalms',\n    'Song of Songs': 'Song of Solomon',\n    'Songs of Solomon': 'Song of Solomon',\n    'Canticles': 'Song of Solomon',\n    'Revelations': 'Revelation',\n    'Revelation of John': 'Revelation'\n  };\n\n  return str\n    .split(';')\n    .map(b => b.trim().replace(/\\s+\\d+(:\\d+)?.*$/, '').trim())\n    .filter(b => b.length > 0)\n    .map(b => b.replace(/^(I{1,3})\\s+/, (m, r) => roman[r] + ' '))\n    .map(b => nameMap[b] || b)\n    .filter((v, i, a) => a.indexOf(v) === i);\n})() }}"
            },
            {
              "name": "speaker",
              "value": "={{ $('Update Sermon Row').item.json.speaker }}"
            },
            {
              "name": "audio",
              "value": "={{ $('Update Sermon Row').item.json.embedLink }}"
            },
            {
              "name": "content",
              "value": "={{ `${$('Build Clips Shortcode').item.json.shortcode}\\n\\n${$json.data}` }}\n"
            },
            {
              "name": "audioEmbed",
              "value": "true"
            },
            {
              "name": "has_full_text",
              "value": "1"
            },
            {
              "name": "videoEmbed",
              "value": "true"
            },
            {
              "name": "video",
              "value": "={{ $('Update Sermon Row').item.json.sermonID }}"
            }
          ]
        },
        "options": {}
      },
